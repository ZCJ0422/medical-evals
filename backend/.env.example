# Local development defaults. Copy to backend/.env and replace production values
# only in your deployment secret store; never commit the copied file.
MEDICAL_EVALS_ENVIRONMENT=development
MEDICAL_EVALS_DATABASE_URL=postgresql+psycopg://medical_evals:medical_evals@localhost:5432/medical_evals
MEDICAL_EVALS_REDIS_URL=redis://localhost:6379/0
MEDICAL_EVALS_ARTIFACT_DIR=backend/data/artifacts
MEDICAL_EVALS_FRONTEND_ORIGIN=http://localhost:3000
# Lease duration for a claimed Worker task (30-86400 seconds).
MEDICAL_EVALS_WORKER_LEASE_SECONDS=300
# Legacy local sqlite task storage for pre-migration paths only.
# MEDICAL_EVALS_DATABASE_PATH=backend/data/medical-evals.sqlite3

# Required in production. Use long, unique random values and a non-empty admin
# password hash. Do not place provider API keys in this file.
# MEDICAL_EVALS_FIXED_ADMIN_PASSWORD_HASH=
# MEDICAL_EVALS_JWT_SECRET=
# MEDICAL_EVALS_ENCRYPTION_SECRET=
